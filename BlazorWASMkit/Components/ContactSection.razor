@using BlazorWASMkit.Components

<div class="card-body">
    <p class="@TitleCssClass card-title">@Title</p>

    @foreach (var block in Blocks)
    {
        <ul class="card-text">
            @foreach (var item in block.Items)
            {
                <li>
                    @if (string.IsNullOrWhiteSpace(item.Href))
                    {
                        @item.Text
                    }
                    else
                    {
                        <a href="@item.Href">@item.Text</a>
                    }
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string TitleCssClass { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<ContactBlock> Blocks { get; set; } = Array.Empty<ContactBlock>();
}
