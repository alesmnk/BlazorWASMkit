@inherits LayoutComponentBase
@using System.Runtime.InteropServices

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="aboutapp" >O</a>
        </div>

        <article class="content px-4">
            @Body
        </article>

        <footer class="app-footer px-4">
            <span>@DotNetVersion</span>
            <span>1.0.2</span>
        </footer>
    </main>
</div>

@code {
    private static readonly string DotNetVersion = RuntimeInformation.FrameworkDescription;    
}
