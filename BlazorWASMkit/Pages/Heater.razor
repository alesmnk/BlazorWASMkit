@page "/heater"
@inject ContactCatalogService Contacts
@using static BlazorWASMkit.Services.ContactGroup

<PageTitle>Kotelna</PageTitle>
<h3>Kotelna</h3>

<InfoHeader ContainerClass="infoboxheaters" BodyClass="infospravceheaters card-body" BannerText="Centrální dispečink 24 h" BannerClass="heater-banner">
    <span class="fw-bold fs-2">PROHEAT s.r.o.</span>
    <br />
    <span class="text-end fs-6">holding</span>
    <div>
        <span class="fw-bold">Sídlo firmy:</span>
        <br />Praha 10, Pražská 1430/36
        <br />https://www.proheat.cz/kontakt/
    </div>
</InfoHeader>

<br />

<div class="card-body">
    <ul class="card-text">
        @foreach (var item in Contacts.Get(HeaterGeneral))
        {
            <li>@item.Text</li>
        }
    </ul>
</div>

<ContactSection Title="Pohotovost kotelny:" TitleCssClass="infospravceheaters" Items="@Contacts.Get(HeaterPohotovost)" />
